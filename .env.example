ENVIRONMENT=local
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=agentops-local
# Set these to true before using sensitive documents (traces contain prompts)
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# Database. Leave empty for memory-only mode (data lost on restart).
# Local file DB:   sqlite:///./agentops_dev.db
# Neon (Postgres): postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
