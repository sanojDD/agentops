ENVIRONMENT=local
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# ---- Model providers (see docs/PROVIDERS.md). Set a key for each one you want to use.
LLM_PROVIDER=openrouter
# Backups tried in order when the primary is rate limited, slow or down (optional):
# LLM_FALLBACK_PROVIDERS=groq,gemini,mistral

OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_REASONING_EFFORT=none     # for reasoning models; leave unset if the model rejects it

# GROQ_API_KEY=your-groq-key
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODE=native                  # or: openai (Google's OpenAI-compatible endpoint)
# GEMINI_REASONING_EFFORT=none         # native: none | dynamic | <number>. Gemini 2.5 "thinks" by default
# MISTRAL_API_KEY=your-mistral-key
# MISTRAL_MODEL=mistral-small-latest

# Output budgets. Reasoning models spend part of these on hidden thinking (512/96 starved them).
# MAX_ANSWER_TOKENS=2048
# MAX_REWRITE_TOKENS=512
# LLM_TIMEOUT_SECONDS=45

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=agentops-local
# Set these to true before using sensitive documents (traces contain prompts)
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# Database. Leave empty for memory-only mode (data lost on restart).
# Local file DB:   sqlite:///./agentops_dev.db
# Neon (Postgres): postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Browser origins allowed to call this API (the frontend's address), comma-separated.
# Local frontend: http://localhost:5173   Render: https://your-web-name.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode: lets visitors try a read-only copy without the admin token (see docs/DEMO_MODE.md).
DEMO_ENABLED=false
# DEMO_QUESTIONS_PER_DAY=60
# DEMO_QUESTIONS_PER_VISITOR_HOUR=12
# DEMO_QUESTIONS_PER_IP_HOUR=20
# DEMO_SESSIONS_PER_IP_HOUR=10
# DEMO_MAX_CONCURRENT=2
# DEMO_MAX_QUESTION_CHARS=300
# DEMO_SESSION_MINUTES=120
# TRUSTED_PROXIES=1

